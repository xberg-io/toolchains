{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "mise": {
    "managerFilePatterns": ["/(^|/)baseline\\.toml$/"]
  },
  "packageRules": [
    {
      "description": "One pull request per baseline bump",
      "matchFileNames": ["baseline.toml"],
      "groupName": "baseline"
    },
    {
      "description": "This repository's own mise.toml follows the baseline through `toolchains.py sync`",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "enabled": false
    },
    {
      "description": "kubectl stays within one minor of the staging GKE server (1.35); move the bound with the cluster",
      "matchFileNames": ["baseline.toml"],
      "matchDepNames": ["kubectl"],
      "allowedVersions": "<1.37.0"
    },
    {
      "description": "nextest tags releases as cargo-nextest-<version>, matching the baseline's version_prefix",
      "matchDepNames": ["github:nextest-rs/nextest"],
      "extractVersion": "^cargo-nextest-(?<version>.+)$"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
