{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "mise": {
    "managerFilePatterns": ["/(^|/)baseline\\.toml$/"]
  },
  "packageRules": [
    {
      "description": "One pull request per baseline bump",
      "matchFileNames": ["baseline.toml"],
      "groupName": "baseline"
    },
    {
      "description": "This repository's own mise.toml follows the baseline through `toolchains.py sync`",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
