{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "mise": {
    "managerFilePatterns": ["/(^|/)baseline\\.toml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Task-set tool pins must equal baseline.toml (tests/test_task_sets.py), so they move in the baseline pull request",
      "managerFilePatterns": ["/(^|/)task-sets/[^/]+\\.toml$/"],
      "matchStrings": ["tools = \\{ node = \"(?<currentValue>[^\"]+)\" \\}"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    }
  ],
  "packageRules": [
    {
      "description": "One pull request per baseline bump",
      "matchFileNames": ["baseline.toml", "task-sets/*.toml"],
      "groupName": "baseline"
    },
    {
      "description": "This repository's own mise.toml follows the baseline through `toolchains.py sync`",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "enabled": false
    },
    {
      "description": "nextest tags releases as cargo-nextest-<version>, matching the baseline's version_prefix",
      "matchDepNames": ["github:nextest-rs/nextest"],
      "extractVersion": "^cargo-nextest-(?<version>.+)$"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
